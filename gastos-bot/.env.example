# Copia este archivo como .env y llena los valores.

# Token del bot: te lo da @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
# Clave de la API de Anthropic: https://platform.claude.com
ANTHROPIC_API_KEY=
# Chats que pueden usar el bot, separados por comas. Envía /chatid en tu grupo para saber su número
# (los grupos tienen números negativos). Si lo dejas vacío, el bot solo responde /start y /chatid.
ALLOWED_CHAT_IDS=

# --- Tus datos fiscales (opcional) ---
# Se muestran con /datosfiscales para copiarlos en los portales de facturación.
# FISCAL_RFC también sirve para avisarte si una factura (XML) salió a nombre de otro RFC.
FISCAL_RFC=
FISCAL_NOMBRE=
FISCAL_CP=
# Ej.: 612 - Personas Físicas con Actividades Empresariales y Profesionales
FISCAL_REGIMEN=
# Ej.: G03 - Gastos en general
FISCAL_USO_CFDI=
FISCAL_EMAIL=

# --- Ajustes (opcional; estos son los valores por defecto) ---
# Modelo de Claude que lee los tickets y cuánto razona: low, medium, high, xhigh o max.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Días del mes en que el bot recuerda los tickets sin facturar (separados por comas; vacío = nunca)
# y hora del recordatorio (0-23).
RECORDATORIO_DIAS=25
RECORDATORIO_HORA=10
# Zona horaria para fechas y recordatorios.
TZ_NAME=America/Mexico_City
# Archivo de la base de datos.
DB_PATH=data/gastos.db
