{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "mx.simulador.doblado",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "modes": {
    "window": {
      "title": "Simulador de Doblado Rotativo",
      "width": 1560, "height": 940, "minWidth": 960, "minHeight": 620,
      "center": true, "resizable": true, "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "SimuladorDoblado",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.1.0",
    "clientVersion": "6.1.0"
  }
}
